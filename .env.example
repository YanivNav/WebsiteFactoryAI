# ─────────────────────────────────────────────────────────────────────────────
# AI Website Factory — environment
#
# Copy to `.env.local`. The Convex command fills in the connection values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex — persistent project state (Phase 1) ──────────────────────────────
# Both values are generated for you the first time you run `pnpm convex`.
# Do not fill these in by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Worker ───────────────────────────────────────────────────────────────────
# Identifies this worker when it leases a project. Any stable string.
WORKER_ID=local-dev
# How long a lease is held before it is considered stale and reclaimable.
LEASE_TTL_SECONDS=300
# How often the worker polls Convex for runnable work.
POLL_INTERVAL_MS=2000
# Delay used by the placeholder stage handler while proving polling and recovery.
FAKE_WORK_MS=1000

# ── Wix setup (Phase 5) ──────────────────────────────────────────────────────
# API key for non-interactive `wix login --api-key` — Wix → API Keys Manager.
WIX_API_KEY=
# Token able to create private repositories in GITHUB_ORG and push to them.
GITHUB_TOKEN=
GITHUB_ORG=
# Where per-project checkouts live. Defaults to <repo>/workspaces.
# WORKSPACES_DIR=

# ── Models ───────────────────────────────────────────────────────────────────
# Model specs use `provider:model-id` (or a bare `model-id`, which defaults to
# openai). Supported provider: openai.
# The spec/design/questions model. Defaults to gpt-5.
# LLM_MODEL=openai:gpt-5
# The model the Codex coding agent uses for the site build. A `provider:` prefix
# is stripped (Codex takes a plain model id). Defaults to gpt-5-codex.
# CODE_MODEL=gpt-5-codex
# Where the coding agent's GLOBAL instructions live (the factory skills). Defaults
# to <repo>/.codex-home — a factory-owned dir, so your own ~/.codex is untouched.
# FACTORY_CODEX_HOME=
