# ─────────────────────────────────────────────────────────────────────────────
# AI Website Factory — environment
#
# Copy to `.env.local` and fill in. NONE of these are required for Phase 0
# (scaffolding) — the app boots and the worker idles without any of them.
# Each key is listed with the phase that first needs it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex — persistent project state (Phase 1) ──────────────────────────────
# Both values are generated for you the first time you run `pnpm convex`.
# Do not fill these in by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── OpenAI — specification generation (Phase 3) ──────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Stitch — design generation (Phase 4) ──────────────────────────────
# Stitch → Settings → API keys.  Used by @google/stitch-sdk.
STITCH_API_KEY=

# ── Anthropic — code generation (Phase 5) ────────────────────────────────────
# https://console.anthropic.com/settings/keys
# Used by @anthropic-ai/claude-agent-sdk, running inside the worker.
ANTHROPIC_API_KEY=

# ── Wix — site provisioning, build, preview, publish (Phase 5) ───────────────
# Wix dashboard → API Keys Manager.
# The worker authenticates non-interactively:  wix login --api-key $WIX_API_KEY
WIX_API_KEY=

# ── Worker ───────────────────────────────────────────────────────────────────
# Identifies this worker when it leases a project. Any stable string.
WORKER_ID=local-dev
# How long a lease is held before it is considered stale and reclaimable.
LEASE_TTL_SECONDS=300
# How often the worker polls Convex for runnable work.
POLL_INTERVAL_MS=2000

# ─────────────────────────────────────────────────────────────────────────────
# Deliberately NOT here:
#   GITHUB_TOKEN — GitHub is not in the critical path. The Wix CLI runs `git init`
#   locally and `wix release` deploys from the local checkout. GitHub returns in V2
#   as an "Export to GitHub" button for handoff — never as a collaboration
#   mechanism, because collaboration is a serialized change-request queue.
# ─────────────────────────────────────────────────────────────────────────────
