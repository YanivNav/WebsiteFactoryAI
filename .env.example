# ─────────────────────────────────────────────────────────────────────────────
# AI Website Factory — environment
#
# Copy to `.env.local` and fill in. NONE of these are required for Phase 0
# (scaffolding) — the app boots and the worker idles without any of them.
# Each key is listed with the phase that first needs it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex — persistent project state (Phase 1) ──────────────────────────────
# Both values are generated for you the first time you run `pnpm convex`.
# Do not fill these in by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── LLM — specification + clarifying questions (Phase 3) ─────────────────────
#
# Model selection goes through the Vercel AI SDK, so switching provider is a config
# change, not a code change. Format: provider:model-id
#
#   LLM_MODEL=openai:gpt-5
#   LLM_MODEL=google:gemini-3-pro
#   LLM_MODEL=anthropic:claude-sonnet-5
#
# Required, with no default on purpose: model names go stale, and a wrong-but-plausible
# default fails confusingly instead of loudly. Pick one that supports structured outputs.
LLM_MODEL=

# Set the key for whichever provider you chose above. Each is read by the AI SDK directly.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Code generation uses the same OpenAI key by default. CODE_MODEL can select another
# CodeGenerator implementation later without changing the stage.

# ── Google Stitch — design generation (Phase 4) ──────────────────────────────
# Stitch → Settings → API keys.  Used by @google/stitch-sdk.
STITCH_API_KEY=

# ── Code generation (Phase 5) ────────────────────────────────────────────────
# Provider/model identifier used by CodeGenerator. The initial implementation is OpenAI.
CODE_MODEL=openai:gpt-5.2-codex

# ── Wix — site provisioning, build, preview, publish (Phase 5) ───────────────
# Wix dashboard → API Keys Manager.
# The worker authenticates non-interactively:  wix login --api-key $WIX_API_KEY
WIX_API_KEY=

# ── Worker ───────────────────────────────────────────────────────────────────
# Identifies this worker when it leases a project. Any stable string.
WORKER_ID=local-dev
# How long a lease is held before it is considered stale and reclaimable.
LEASE_TTL_SECONDS=300
# How often the worker polls Convex for runnable work.
POLL_INTERVAL_MS=2000

# ── GitHub — source backup and developer collaboration (Phase 5) ─────────────
# A private repository is created for every project in this organization.
GITHUB_ORG=
# Fine-grained token or GitHub App token with permission to create private repositories
# in GITHUB_ORG and read/write their contents.
GITHUB_TOKEN=
